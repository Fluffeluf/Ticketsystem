<Window x:Class="Ticketsystem_WPF.UI.TicketAnlegenW"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ticketsystem_WPF.UI"
        mc:Ignorable="d"
        Title="TicketAnlegenW" Height="660" Width="550"
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">
    <Border CornerRadius="20" 
            BorderBrush="Black"
            BorderThickness="3">
        <Border.Background>
            <LinearGradientBrush>
                <GradientStop Color="#c8b3f9" Offset="0"/>
                <GradientStop Color="#8bcefc" Offset="0.45"/>
                <GradientStop Color="#a4dce4" Offset="0.75"/>
                <GradientStop Color="#eec0da" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30">
                    </RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="5"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnMinimize"
            BorderThickness="0"
            Content="-"
            Foreground="Black"
            FontSize="16"
            FontFamily="Arial"
            Cursor="Hand"
            Grid.Column="1"
            Click="btnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#eec0da"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Background" Value="#ee9ac9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                        CornerRadius="9"
                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnClose"
            BorderThickness="0"
            Content="x"
            Foreground="Black"
            FontSize="13"
            FontFamily="Arial"
            Cursor="Hand"
            Grid.Column="2"
            Click="btnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#c8b3f9"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Background" Value="#FFB191FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                        CornerRadius="9"
                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
            <Button x:Name="OkButton" Content="Ok" HorizontalAlignment="Left" Margin="21,565,0,0" VerticalAlignment="Top" Height="42" Width="119" FontSize="18" Click="OkButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#c8b3f9"/>
                    </Style>
                </Button.Style>
            </Button>
            <Label x:Name="WindowUeberschrift" Content="{Binding WindowTitle}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="22"/>
            <Label x:Name="KundeLabel" Content="Kunde" HorizontalAlignment="Left" Margin="21,56,0,0" VerticalAlignment="Top" FontSize="18"/>
            <ComboBox x:Name="KundeCombo"
                      ItemsSource="{Binding KundenListe}"
                      SelectedItem="{Binding SelectedKunde}"
                      DisplayMemberPath="FullName"
                      IsEnabled="{Binding IsKundeEnabled}"
                      HorizontalAlignment="Left" Margin="170,56,0,0" VerticalAlignment="Top" Width="130" Height="30" FontSize="18"/>
            <Button x:Name="AbbrechenButton" Content="Abbrechen" HorizontalAlignment="Left" Margin="360,565,0,0" VerticalAlignment="Top" Height="42" Width="119" FontSize="18" Click="AbbrechenButton_Click" RenderTransformOrigin="0.505,-0.309">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#8bcefc"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="NeuKundeButton" Content="Neuer Kunde" HorizontalAlignment="Left" Margin="360,58,0,0" VerticalAlignment="Top" Height="30" Width="120" FontSize="18" Click="NeuKundeButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#c8b3f9"/>
                    </Style>
                </Button.Style>
            </Button>
            <Label x:Name="DatumLabel" Content="Datum" HorizontalAlignment="Left" Margin="21,115,0,0" VerticalAlignment="Top" FontSize="18"/>
            <Label x:Name="UeberschriftLabel" Content="Überschrift" HorizontalAlignment="Left" Margin="21,208,0,0" VerticalAlignment="Top" FontSize="18"/>
            <Label x:Name="BeschreibungLabel" Content="Beschreibung" HorizontalAlignment="Left" Margin="21,296,0,0" VerticalAlignment="Top" FontSize="18"/>
            <Label x:Name="StatusLabel" Content="Status" HorizontalAlignment="Left" Margin="21,487,0,0" VerticalAlignment="Top" FontSize="18"/>
            <TextBox x:Name="UeTextBox"
                     Text="{Binding CurrentTicket.Ueberschrift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Left" Margin="170,208,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="264" FontSize="18" RenderTransformOrigin="-0.003,0.503">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="AliceBlue"/>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBox x:Name="BeschreibungText"
                     Text="{Binding CurrentTicket.Beschreibung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Height="170" Width="264" Margin="170,307,0,0" FontSize="18">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="AliceBlue"/>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <ComboBox x:Name="StatusCombo"
                      ItemsSource="{Binding VerfuegbareStatus}"
                      SelectedItem="{Binding CurrentTicket.Status}"
                      IsEnabled="{Binding IsEditMode}"
                      HorizontalAlignment="Left" Margin="170,482,0,0" VerticalAlignment="Top" Width="130" Height="30" FontSize="18">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Background" Value="AliceBlue"/>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
            <Label x:Name="Datum" Content="{Binding CurrentTicket.ErstellungsDatum, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Left" Margin="171,115,0,0" VerticalAlignment="Top" FontSize="18"/>

        </Grid>
    </Border>
</Window>
