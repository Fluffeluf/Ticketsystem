<Window x:Class="Ticketsystem_WPF.UI.TicketLoeschen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ticketsystem_WPF.UI"
        mc:Ignorable="d"
        Title="TicketLoeschen" Height="250" Width="450"
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">
    <Border CornerRadius="20" 
            BorderBrush="Black"
            BorderThickness="3">
        <Border.Background>
            <LinearGradientBrush>
                <GradientStop Color="#c8b3f9" Offset="0"/>
                <GradientStop Color="#8bcefc" Offset="0.45"/>
                <GradientStop Color="#a4dce4" Offset="0.75"/>
                <GradientStop Color="#eec0da" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="30">
        </RowDefinition>
    </Grid.RowDefinitions>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="btnMinimize"
            BorderThickness="0"
            Content="-"
            Foreground="Black"
            FontSize="16"
            FontFamily="Arial"
            Cursor="Hand"
            Grid.Column="1"
            Click="btnMinimize_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#eec0da"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="#ee9ac9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Width="18" Height="18"
                        CornerRadius="9"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="btnClose"
            BorderThickness="0"
            Content="x"
            Foreground="Black"
            FontSize="13"
            FontFamily="Arial"
            Cursor="Hand"
            Grid.Column="2"
            Click="btnClose_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#c8b3f9"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="#FFB191FD"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Width="18" Height="18"
                        CornerRadius="9"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Grid>
            <Button Name="JaButton" Content="Ja" HorizontalAlignment="Left" Margin="73,167,0,0" VerticalAlignment="Top" Width="115" Height="42" FontSize="18" Click="JaButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#c8b3f9"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button Name="NeinButton" Content="Nein" HorizontalAlignment="Left" Margin="296,167,0,0" VerticalAlignment="Top" Width="115" Height="42" FontSize="18" Click="NeinButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#8bcefc"/>
                    </Style>
                </Button.Style>
            </Button>
            <Label Name="LoeschenLabel" Content="Löschen" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="22"/>
            <Label Name="SicherLabel" Content="Sind sie sich sicher?" HorizontalAlignment="Center" Margin="0,75,0,0" VerticalAlignment="Top" FontSize="18"/>
        </Grid>
    </Border>
</Window>
